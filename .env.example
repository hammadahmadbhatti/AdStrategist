# Copy to .env and edit. Everything is optional: with no model configured
# the pipeline still runs in rule-based "offline" mode.

# ---- Which model does what -------------------------------------------------
# Research model: reads pages, classifies, extracts. Many small calls.
# Writing model: ad copy, gap analysis, executive summary. Few calls, quality matters.
# Values: offline | ollama | mlx | openai | anthropic
RESEARCH_PROVIDER=ollama
WRITING_PROVIDER=ollama

# ---- Local: Ollama ---------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
# 8 GB Macs: llama3.2:3b (2 GB) or gemma3:4b (3.3 GB, better writing)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096

# ---- Retrieval (RAG) and pipeline engine -------------------------------------
# auto = use retrieval when the packages and the embedding model are installed. off = never.
# Setup: pip install -e ".[rag]"   and   ollama pull embeddinggemma
RAG=auto
EMBED_MODEL=embeddinggemma
# Passages scoring below this are treated as not about the question. Tuned for embeddinggemma.
RAG_MIN_SCORE=0.25
# native = plain loop. langgraph = state graph that also reviews and revises ad copy.
ENGINE=native

# ---- Video ad ---------------------------------------------------------------
# Optional local vision model that looks at your own photos and clips so the script matches them.
# Install with: ollama pull moondream   Leave empty to go by file names instead.
VISION_MODEL=
# research = the local research model writes the video script. writing = use the writing model.
VIDEO_SCRIPT_ROLE=research

# ---- Local: MLX (run `mlx_lm.server --model <model>` first) ----------------
MLX_BASE_URL=http://localhost:8080/v1
MLX_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit

# ---- Paid: any OpenAI-compatible API (OpenAI, OpenRouter, Groq, LM Studio) -
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=


# ---- Paid: Claude (Anthropic API) ------------------------------------------
# Leave the key empty if you signed in with `ant auth login`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Leave empty for models without effort support.
ANTHROPIC_EFFORT=high

# ---- Data sources ----------------------------------------------------------
# Optional. Lets the ad-intel step read competitor ads from the Meta Ad Library API.
META_ACCESS_TOKEN=

# ---- Defaults --------------------------------------------------------------
DEFAULT_COUNTRY=DE
DEFAULT_CURRENCY=EUR
OUTPUT_DIR=runs
